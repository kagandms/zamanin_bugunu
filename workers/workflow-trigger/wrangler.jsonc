{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zamanin-bugunu-workflow-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {"crons": ["7,27,47 * * * *", "37 * * * *"]},
  "observability": {"enabled": true}
}
