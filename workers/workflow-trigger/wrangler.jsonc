{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zamanin-bugunu-workflow-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"DISPATCH_ENABLED": "false"},
  "triggers": {"crons": ["7,27,47 * * * *", "37 * * * *"]},
  "limits": {"cpu_ms": 10},
  "observability": {"enabled": true}
}
